# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Memberstack
NEXT_PUBLIC_MEMBERSTACK_PUBLIC_KEY=your_memberstack_public_key
MEMBERSTACK_SECRET_KEY=your_memberstack_secret_key

# Admin Memberstack IDs (comma-separated)
NEXT_PUBLIC_ADMIN_MEMBER_IDS=your_memberstack_member_id

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=GBH Capital <noreply@alerts.gbhinvestments.com>

# Stripe (member investment contributions via ACH)
# Get keys from https://dashboard.stripe.com/apikeys — use sk_test_... first
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From your webhook endpoint config (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Public URL of the deployed app (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.com
